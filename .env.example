# ---------------------------------------------------------------------------
# Option 1, recommended: the proxy in server/ holds the key.
# The browser never sees it. Point the app at the proxy:
REACT_APP_API_BASE=/api
#
# and give the key to the server instead, in its own environment (not here,
# nothing REACT_APP_ prefixed stays secret):
#
#   COINGECKO_KEY=your_key_here COINGECKO_PLAN=demo npm run server
#
# ---------------------------------------------------------------------------
# Option 2: the browser calls coingecko directly with the key below.
# Simpler to deploy, but create react app inlines the value into the bundle,
# so anyone using the site can read it. Use a rotatable demo key only.
REACT_APP_COINGECKO_KEY=

# demo (the default) or pro, they use a different host and header
REACT_APP_COINGECKO_PLAN=demo
