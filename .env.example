# A CoinGecko api key raises the rate limit so the fast refresh settings work.
# Copy this file to .env.local (which is gitignored) and fill the key in.
#
# Get a free demo key at https://www.coingecko.com/en/developers/dashboard
#
# NOTE: create-react-app inlines these values into the javascript bundle at
# build time, so anyone using the site can read the key. Use a demo key you
# can rotate, never a paid key you care about, and put a small backend in
# front of the api if the key must stay private.

REACT_APP_COINGECKO_KEY=

# demo (the default) or pro, they use a different host and header
REACT_APP_COINGECKO_PLAN=demo
